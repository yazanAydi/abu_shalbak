# Copy to .env.store on the SHOP SERVER PC only.
# Start store: npm run store:up

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Ramallah / Palestine local time for calendar-day boundaries
TZ=Asia/Hebron

JWT_SECRET=generate-a-long-random-string-32-chars-minimum
JWT_EXPIRES_IN=8h

# Point this at the real store database — not supermarket-dev.db
DATABASE_PATH=/app/data/supermarket.db
BACKUP_DIR=/app/backups

TELEGRAM_USE_POLLING=1
TELEGRAM_REFUND_BOT_TOKEN=
TELEGRAM_REFUND_WEBHOOK_SECRET=
TELEGRAM_EXPIRY_BOT_TOKEN=
TELEGRAM_REFUND_CHAT_ID=
TELEGRAM_EXPIRY_CHAT_ID=
TELEGRAM_ZIMMA_BOT_TOKEN=
TELEGRAM_ZIMMA_CHAT_ID=
TELEGRAM_ZIMMA_WEBHOOK_SECRET=
TELEGRAM_SULAF_BOT_TOKEN=
TELEGRAM_SULAF_CHAT_ID=
TELEGRAM_SULAF_WEBHOOK_SECRET=
TELEGRAM_MANAGER_CHAT_ID=
# Optional: comma-separated Telegram user IDs allowed to approve. If empty, anyone in the manager chat can approve.
TELEGRAM_MANAGER_USER_IDS=
TELEGRAM_EXPIRY_ALERT_HOUR=8
TELEGRAM_EXPIRY_DAYS=7

# Face attendance kiosk — optional legacy X-Kiosk-Key fallback. Prefer device enrollment.
KIOSK_API_KEY=generate-a-long-random-kiosk-key-here

# Set to 1 when behind Tailscale Serve / nginx so rate limits use the client IP.
# TRUST_PROXY=1
