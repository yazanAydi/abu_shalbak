# Copy to frontend-pos/.env on YOUR DEV PC only (npm start).
# Docker store builds ignore this file and use same-origin /api on :3000.
PORT=3002
REACT_APP_API_BASE=http://127.0.0.1:5001
REACT_APP_ADMIN_URL=http://127.0.0.1:3001

# Ramallah shop calendar (must match backend TZ)
REACT_APP_SHOP_TZ=Asia/Hebron
