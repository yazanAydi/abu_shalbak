# Cashier-PC receipt print helper only. Do not copy .env.store here.
# This file is read by backend/scripts/receipt-print-dialog-helper.mjs
# It does not start Docker, the API, or a database.

# Exact Windows printer name (Devices and Printers). Required.
RECEIPT_PRINTER=RONGTA 80mm Series Printer

# POS origin only — scheme + host + port, no /pos path.
# Edge --app=http://STORE_LAN_IP:3000/pos sends Origin: http://STORE_LAN_IP:3000
RECEIPT_PRINT_ALLOWED_ORIGINS=http://192.168.1.10:3000

# Thermal HTML width used when the helper builds the PDF. Default 80.
RECEIPT_WIDTH_MM=80

# Optional: named paper size for pdf-to-printer. Leave unset unless the driver requires it.
# RECEIPT_PAPER_SIZE=80mm

# Leave UNSET for paper. save writes a PDF to tmp/receipt-test/ and does not print.
# RECEIPT_PRINT_TEST_MODE=save

# RECEIPT_PRINT_DIALOG_HELPER_PORT=17892
