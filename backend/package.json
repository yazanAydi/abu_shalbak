{
  "name": "abo-shalbak-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:concurrency": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/load",
    "seed:perf": "node scripts/seed-perf-db.mjs",
    "bench": "node scripts/bench.mjs",
    "explain": "node scripts/explain-plans.mjs",
    "loadtest:seed": "node scripts/loadtest/seed-loadtest-db.mjs",
    "loadtest": "node scripts/loadtest/runner.mjs",
    "loadtest:sweep": "node scripts/loadtest/runner.mjs --sweep 5,10,20,30,50",
    "loadtest:multiproc": "node scripts/loadtest/runner.mjs --mode multiproc --processes 3",
    "loadtest:resilience": "node scripts/loadtest/runner.mjs --mode restart --processes 2"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
